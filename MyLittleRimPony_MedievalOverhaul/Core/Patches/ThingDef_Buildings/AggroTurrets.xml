<Patch>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar"]/description</xpath>
				<value>
					<description>This guy seems like he's a lot of fun at parties, but at least he makes the room a bit more bearable to be in.</description>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_QuibblePants"]/description</xpath>
				<value>
					<description>This guy seems like the kind who never stops talking, but at least he makes the room a bit more bearable to be in.</description>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_ZephyrBreeze"]/description</xpath>
				<value>
					<description>This guy seems like he oozes arrogance, but at least he makes the room a bit more bearable to be in.</description>
				</value>
			</li>
			
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/statBases</xpath>
				<value>
					<Beauty>5</Beauty>
				</value>
			</li>
		
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/costStuffCount</xpath>
				<value>
					<costStuffCount>300</costStuffCount>
				</value>
			</li>
		
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/stuffCategories</xpath>
				<value>
					<li>Stony</li>
				</value>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/costList</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/building</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Mudbriar" or defName="MLRP_QuibblePants" or defName="MLRP_ZephyrBreeze"]/researchPrerequisites</xpath>
			</li>
		</operations>
	</Operation>

</Patch>

