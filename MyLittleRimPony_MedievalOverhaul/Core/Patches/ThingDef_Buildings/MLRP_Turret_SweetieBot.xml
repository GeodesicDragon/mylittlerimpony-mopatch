<Patch>

	<!--Turn Sweetie Bot turrets into glorified art pieces.-->
	<!--This will deter players from building them, and is easier than trying to remove them outright.-->

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/label</xpath>
				<value>
					<label>Sweetie Bot</label>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/description</xpath>
				<value>
					<description>It isn't quite clear what this device is meant to be, but at least it looks nice.</description>
				</value>
			</li>
			
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases</xpath>
				<value>
					<Beauty>10</Beauty>
				</value>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases/ShootingAccuracyTurret</xpath>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases/AccuracyTouch</xpath>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases/AccuracyShort</xpath>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases/AccuracyMedium</xpath>
			</li>

			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/statBases/AccuracyLong</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/comps</xpath>
			</li>
		
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/costStuffCount</xpath>
				<value>
					<costStuffCount>300</costStuffCount>
				</value>
			</li>
		
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/stuffCategories</xpath>
				<value>
					<li>Stony</li>
				</value>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/costList</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/building</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/placeWorkers</xpath>
			</li>
		
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MLRP_Turret_SweetieBot"]/researchPrerequisites</xpath>
			</li>
		</operations>
	</Operation>
	
</Patch>