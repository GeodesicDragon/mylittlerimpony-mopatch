			<comps>
			  <li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
				  <li>ToolCabinet</li>
				  <li>DankPyon_ToolRack</li>
				</linkableFacilities>
			  </li>
			</comps>
		</value>
	</Operation>
	
</Patch>				
				
				