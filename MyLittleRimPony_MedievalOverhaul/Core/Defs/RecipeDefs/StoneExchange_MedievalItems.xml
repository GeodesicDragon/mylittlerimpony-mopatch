<Defs>

	<RecipeDef ParentName="MLRP_SE_RecipeBase">
		<defName>MLRP_SE_DankPyon_BlocksClay</defName>
		<label>purchase clay blocks</label>
		<description>Use silver to purchase 100 clay blocks.</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Silver</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
			<DankPyon_BlocksClay>100</DankPyon_BlocksClay>
		</products>	
	</RecipeDef>
	
	<RecipeDef ParentName="MLRP_SE_RecipeBase">
		<defName>MLRP_SE_SellDankPyon_BlocksClay</defName>
		<label>sell clay blocks</label>
		<description>Sell 100 clay blocks in exchange for silver.</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>DankPyon_BlocksClay</li>
					</thingDefs>
				</filter>
				<count>100</count>
			</li>
		</ingredients>
		<products>
			<Silver>100</Silver>
		</products>	
	</RecipeDef>

</Defs>