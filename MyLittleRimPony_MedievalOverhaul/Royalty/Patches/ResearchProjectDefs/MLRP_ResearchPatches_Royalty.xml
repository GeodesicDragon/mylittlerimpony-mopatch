<Patch>

	<!--Replace high tech research bench with MO equivalent-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="MLRP_HarmonyChipResearch" or defName="MLRP_PsychicItemsResearch"]/requiredResearchBuilding</xpath>
		<value>
			<requiredResearchBuilding>DankPyon_AdvancedResearchBench</requiredResearchBuilding>   
		</value>
	</Operation>
	
	<!--Remove multi analyser requirement since I can't think of anything to replace it with-->
	
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ResearchProjectDef[defName="MLRP_HarmonyChipResearch" or defName="MLRP_PsychicItemsResearch"]/requiredResearchFacilities</xpath>
	</Operation>

</Patch>